---
// Bandierina per il cambio lingua: Italia per l'italiano, Regno Unito per l'inglese.
// Disegnata in SVG, così si vede uguale su tutti i sistemi (le emoji delle bandiere no).
interface Props { lingua: 'en' | 'it' }
const { lingua } = Astro.props;
---
{lingua === 'it'
  ? (
    <svg class="bandiera" viewBox="0 0 3 2" width="24" height="16" aria-hidden="true">
      <rect width="1" height="2" fill="#009246" />
      <rect x="1" width="1" height="2" fill="#fff" />
      <rect x="2" width="1" height="2" fill="#ce2b37" />
    </svg>
  )
  : (
    <svg class="bandiera" viewBox="0 0 60 30" width="24" height="12" aria-hidden="true">
      <clipPath id="bandiera-uk-t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
      <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
      <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#bandiera-uk-t)" stroke="#c8102e" stroke-width="4" />
      <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
      <path d="M30,0 v30 M0,15 h60" stroke="#c8102e" stroke-width="6" />
    </svg>
  )}

<style>
  .bandiera { display: block; border-radius: 2px; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18); overflow: hidden; }
</style>
