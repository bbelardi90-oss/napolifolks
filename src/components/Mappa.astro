---
import { getCollection } from 'astro:content';
import { MAPPA_VISTA_PREDEFINITA } from '../config';
import Segnaposto from './Segnaposto.astro';

interface Props { altezza?: string }
const { altezza = '70vh' } = Astro.props;

const luoghi = await getCollection('luoghi');
const sessioni = await getCollection('sessioni');
const punti = luoghi.map((l) => ({
  nome: l.data.nome,
  lat: l.data.lat,
  lng: l.data.lng,
  sessioni: sessioni
    .filter((s) => s.data.luogo?.id === l.id)
    .map((s) => ({ titolo: s.data.titolo, url: `/sessioni/${s.id}/` })),
}));
---
<div class="mappa-box">
  <div class="mappa" style={`height:${altezza}`} data-punti={JSON.stringify(punti)} data-vista={JSON.stringify(MAPPA_VISTA_PREDEFINITA)}></div>
  {punti.length === 0 && (
    <p class="vuota"><Segnaposto>luoghi delle registrazioni: ancora da inserire in src/content/luoghi.json</Segnaposto></p>
  )}
</div>

<style>
  .mappa-box { position: relative; }
  .mappa { width: 100%; min-height: 320px; background: var(--fondo-2); }
  .vuota {
    position: absolute; left: 12px; right: 12px; bottom: 12px; z-index: 500; margin: 0;
    background: var(--fondo); padding: 10px 12px;
  }
  /* Tasselli OSM scuriti per il tema del sito */
  .mappa :global(.leaflet-tile-pane) { filter: grayscale(1) invert(1) brightness(0.85) contrast(0.9); }
  .mappa :global(.leaflet-container) { font-family: var(--sans); }
  .mappa :global(.leaflet-popup-content-wrapper),
  .mappa :global(.leaflet-popup-tip) { background: var(--fondo); color: var(--testo); border-radius: 2px; }
  .mappa :global(.leaflet-popup-content) { font-family: var(--sans); font-size: 0.85rem; }
  .mappa :global(.leaflet-popup-content strong) { font-family: var(--serif); font-style: italic; font-size: 1.2rem; font-weight: 400; }
  .mappa :global(.leaflet-control-attribution) { background: rgba(17,16,14,0.8); color: var(--testo-2); }
  .mappa :global(.leaflet-control-attribution a) { color: var(--testo); }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Punto = { nome: string; lat: number; lng: number; sessioni: { titolo: string; url: string }[] };
  const esc = (t: string) => t.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const accento = getComputedStyle(document.documentElement).getPropertyValue('--accento').trim();

  document.querySelectorAll<HTMLElement>('.mappa').forEach((el) => {
    const punti: Punto[] = JSON.parse(el.dataset.punti ?? '[]');
    const vista = JSON.parse(el.dataset.vista ?? '{}');
    const mappa = L.map(el, { scrollWheelZoom: false }).setView([vista.lat, vista.lng], vista.zoom);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(mappa);

    const segni = punti.map((p) => {
      const elenco = p.sessioni.map((s) => `<li><a href="${s.url}">${esc(s.titolo)}</a></li>`).join('');
      return L.circleMarker([p.lat, p.lng], { radius: 8, color: accento, fillColor: accento, fillOpacity: 0.8, weight: 1 })
        .bindPopup(`<strong>${esc(p.nome)}</strong>${elenco ? `<ul>${elenco}</ul>` : ''}`)
        .addTo(mappa);
    });
    if (segni.length) mappa.fitBounds(L.featureGroup(segni).getBounds().pad(0.3), { maxZoom: 14 });
  });
</script>
