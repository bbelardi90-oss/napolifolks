---
import type { Sessione } from '../lib/sessioni';
import SchedaSessione from './SchedaSessione.astro';

interface Props { sessioni: Sessione[] }
const { sessioni } = Astro.props;
---
<!--
  Da telefono: una colonna. Da computer (>= 900 px): l'ultima uscita a tutta
  larghezza, poi le altre su tre colonne, sempre senza spazi tra i riquadri.
-->
<ul class="galleria">
  {sessioni.map((s, i) => <SchedaSessione sessione={s} primo={i === 0} />)}
</ul>

<style>
  /* overflow-x: clip impedisce lo scorrimento orizzontale se un riquadro esce di poco. */
  .galleria { margin: 0; padding: 0; display: grid; gap: 0; overflow-x: clip; }

  @media (min-width: 900px) {
    /* Griglia da 6: i riquadri piccoli ne occupano 2 (= tre colonne). */
    .galleria { grid-template-columns: repeat(6, 1fr); }
    .galleria > :global(*) { grid-column: span 2; }
    /* L'ultima uscita (prima in elenco) a tutta larghezza. */
    .galleria > :global(:first-child) { grid-column: 1 / -1; }
    /* Ultima riga incompleta: due riquadri a metà, oppure uno a tutta larghezza. */
    .galleria > :global(:nth-last-child(2):nth-child(3n + 2)),
    .galleria > :global(:last-child:nth-child(3n + 3)) { grid-column: span 3; }
    .galleria > :global(:last-child:nth-child(3n + 2):not(:first-child)) { grid-column: 1 / -1; }

    /* Da dove cresce il riquadro quando ci passa sopra il mouse:
       colonna sinistra verso destra, destra verso sinistra, centrale dal centro. */
    .galleria > :global(:nth-child(3n + 2)) { transform-origin: left center; }
    .galleria > :global(:nth-child(3n + 3)) { transform-origin: center center; }
    .galleria > :global(:nth-child(3n + 4)) { transform-origin: right center; }
    .galleria > :global(:last-child:nth-child(3n + 3)) { transform-origin: right center; }
  }
</style>

<script>
  // Su telefono il titolo compare solo mentre il dito tocca il video
  // e sparisce quando il dito si alza.
  document.querySelectorAll('.quadro').forEach((q) => {
    q.addEventListener('touchstart', () => q.classList.add('attivo'), { passive: true });
    const spegni = () => q.classList.remove('attivo');
    q.addEventListener('touchend', spegni);
    q.addEventListener('touchcancel', spegni);
  });
</script>
