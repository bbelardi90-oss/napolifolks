---
import type { Sessione } from '../lib/sessioni';
import SchedaSessione from './SchedaSessione.astro';

interface Props { sessioni: Sessione[] }
const { sessioni } = Astro.props;
---
<ul class="galleria">
  {sessioni.map((s, i) => <SchedaSessione sessione={s} primo={i === 0} />)}
</ul>

<style>
  /* I video uno sotto l'altro, a tutta larghezza, senza spazi. */
  .galleria { margin: 0; padding: 0; display: grid; gap: 0; }
</style>

<script>
  // Su telefono (niente mouse) il titolo compare sul video che passa
  // al centro dello schermo mentre si scorre.
  if (window.matchMedia('(hover: none)').matches) {
    let attivo: Element | null = null;
    let inAttesa = false;
    const aggiorna = () => {
      inAttesa = false;
      const sotto = document.elementFromPoint(innerWidth / 2, innerHeight / 2)?.closest('.quadro') ?? null;
      if (sotto === attivo) return;
      attivo?.classList.remove('attivo');
      sotto?.classList.add('attivo');
      attivo = sotto;
    };
    const pianifica = () => { if (!inAttesa) { inAttesa = true; requestAnimationFrame(aggiorna); } };
    addEventListener('scroll', pianifica, { passive: true });
    addEventListener('resize', pianifica);
    pianifica();
  }
</script>
