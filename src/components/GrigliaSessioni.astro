---
import type { Sessione } from '../lib/sessioni';
import SchedaSessione from './SchedaSessione.astro';

interface Props { sessioni: Sessione[] }
const { sessioni } = Astro.props;
---
<ul class="galleria">
  {sessioni.map((s, i) => <SchedaSessione sessione={s} primo={i === 0} />)}
</ul>

<style>
  /* I video uno sotto l'altro, a tutta larghezza, senza spazi. */
  .galleria { margin: 0; padding: 0; display: grid; gap: 0; overflow-x: clip; }
  /* overflow-x: clip taglia l'ingrandimento ai lati, così la pagina non scorre in orizzontale. */
</style>

<script>
  // Su telefono il titolo compare solo mentre il dito tocca il video
  // e sparisce quando il dito si alza.
  document.querySelectorAll('.quadro').forEach((q) => {
    q.addEventListener('touchstart', () => q.classList.add('attivo'), { passive: true });
    const spegni = () => q.classList.remove('attivo');
    q.addEventListener('touchend', spegni);
    q.addEventListener('touchcancel', spegni);
  });
</script>
