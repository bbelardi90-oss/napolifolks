---
import Base from '../../layouts/Base.astro';
import GrigliaSessioni from '../../components/GrigliaSessioni.astro';
import { tutteLeSessioni } from '../../lib/sessioni';

// Archivio: per ora senza filtri (poche sessioni). Si possono rimettere con
// gruppo/luogo/anno quando il materiale cresce (vedi la storia del file in git).
const sessioni = await tutteLeSessioni();
---
<Base titolo="Sessions">
  <section class="contenitore intestazione-archivio">
    <h1>Sessions</h1>
  </section>
  <GrigliaSessioni sessioni={sessioni} />
</Base>

<style>
  .intestazione-archivio { padding-block: clamp(32px, 6vw, 64px) clamp(24px, 4vw, 40px); }
  h1 { margin: 0; }
</style>
