---
import Base from '../layouts/Base.astro';
import Segnaposto from '../components/Segnaposto.astro';
import { SITO } from '../config';

const oggetto = encodeURIComponent('Proposta di un gruppo — Napoli Folks');
---
<Base titolo="Proponi un gruppo">
  <section class="sezione contenitore">
    <h1>Proponi un gruppo</h1>
    <div class="testo">
      <Segnaposto blocco>testo introduttivo della pagina</Segnaposto>
      <p>Scrivi a <a href={`mailto:${SITO.email}`}>{SITO.email}</a>.</p>
      <Segnaposto blocco>informazioni da includere nell'email</Segnaposto>
      <p><a class="pulsante" href={`mailto:${SITO.email}?subject=${oggetto}`}>Scrivi un'email</a></p>
    </div>
  </section>
</Base>
