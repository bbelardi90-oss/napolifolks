---
import Base from '../layouts/Base.astro';
import Segnaposto from '../components/Segnaposto.astro';
import Icona from '../components/Icona.astro';
import { SITO } from '../config';

// Squadra: nomi forniti da Bruno, ruoli tradotti in inglese. Bio e foto da ricevere.
// Per aggiungere una foto: metti il file in public/squadra/ e scrivi il percorso in `foto`.
const squadra: { nome: string; ruolo: string; foto: string | null; bio: string | null }[] = [
  { nome: 'Marcello Squillante', ruolo: 'Art Director', foto: null, bio: null },
  { nome: 'Luca Lanzano', ruolo: 'Filmmaker', foto: null, bio: null },
  { nome: 'Bruno Belardi', ruolo: 'Sound Engineer', foto: null, bio: null },
];

const link = [
  { icona: 'instagram' as const, testo: 'Instagram', dettaglio: '@napoli_folks_live', url: SITO.instagram },
  { icona: 'youtube' as const, testo: 'YouTube', dettaglio: '@napolifolkslive', url: SITO.youtube },
  { icona: 'email' as const, testo: 'Email', dettaglio: SITO.email, url: `mailto:${SITO.email}` },
];
---
<Base titolo="About">
  <section class="sezione contenitore">
    <h1>About</h1>
    <div class="testo">
      <!-- Testo scritto a partire dalle parole di Bruno: da approvare. -->
      <p class="apertura">Folk musicians passing through Naples, recorded outdoors.</p>
      <p>Napoli Folks records folk musicians outdoors, in Naples. We catch the artists who happen to pass through the city.</p>
    </div>

    <ul class="squadra">
      {squadra.map((p) => (
        <li class="persona">
          {p.foto
            ? <img class="foto" src={p.foto} alt={p.nome} width="800" height="1000" loading="lazy" />
            : <div class="foto vuota"><Segnaposto>photo of {p.nome}</Segnaposto></div>}
          <h2>{p.nome}</h2>
          <p class="ruolo dettaglio">{p.ruolo}</p>
          {p.bio
            ? <p class="bio">{p.bio}</p>
            : <Segnaposto blocco>bio of {p.nome}</Segnaposto>}
        </li>
      ))}
    </ul>

    <div class="testo">
      <h2 class="titolo-contatti">Find us</h2>
      <p>All our videos and materials are on Instagram and YouTube.</p>
      <ul class="contatti">
        {link.map((l) => (
          <li>
            <a href={l.url} rel="noopener">
              <Icona nome={l.icona} />
              <span><strong>{l.testo}</strong> <span class="dettaglio-link">{l.dettaglio}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .apertura { font-family: var(--serif); font-size: clamp(1.35rem, 3.2vw, 1.9rem); line-height: 1.25; margin-bottom: 0.6em; }
  .squadra {
    list-style: none; margin: clamp(40px, 7vw, 80px) 0; padding: 0;
    display: grid; gap: clamp(40px, 5vw, 56px) clamp(24px, 3vw, 40px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .persona { display: grid; align-content: start; gap: 0; }
  .foto { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; margin-bottom: 20px; }
  .foto.vuota {
    display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px;
    background: var(--fondo-2); border: 1px solid var(--linea);
  }
  .persona h2 { font-size: clamp(1.6rem, 3vw, 2rem); margin: 0 0 6px; }
  .ruolo { margin: 0 0 14px; color: var(--accento); }
  .bio { margin: 0; color: var(--testo-2); max-width: 32em; }
  .titolo-contatti { margin-top: 0; }
  .contatti { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .contatti a { display: inline-flex; align-items: center; gap: 14px; padding: 8px 0; text-decoration: none; }
  .contatti strong { font-weight: 500; }
  .dettaglio-link { color: var(--testo-2); margin-left: 6px; }
  .contatti a:hover, .contatti a:hover .dettaglio-link { color: var(--accento); }
</style>
