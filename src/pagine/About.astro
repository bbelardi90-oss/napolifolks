---
import Base from '../layouts/Base.astro';
import Segnaposto from '../components/Segnaposto.astro';
import Icona from '../components/Icona.astro';
import { SITO } from '../config';
import { type Lingua } from '../i18n';

interface Props { l: Lingua }
const { l } = Astro.props;

// Squadra: nomi forniti da Bruno, ruoli tradotti in inglese. Foto da ricevere.
// Bio: una riga sul mestiere + una sull'attività principale, senza premi (scelta di Bruno).
// Fonti: cinemaitaliano.info, siti di Ars Nova Napoli, brunobelardi.com; confermate da Bruno.
// Il ruolo nel progetto è già scritto sopra la bio, quindi la bio non lo ripete.
// `bio` può contenere <em> per i titoli delle opere.
// Per aggiungere una foto: metti il file in public/squadra/ e scrivi il percorso in `foto`.
type Testo = Record<Lingua, string>;
const squadra: { nome: string; ruolo: Testo; foto: string | null; bio: Testo | null }[] = [
  {
    nome: 'Marcello Squillante', foto: null,
    ruolo: { en: 'Art Director', it: 'Direzione artistica' },
    bio: {
      en: 'Singer and accordionist. Leads Ars Nova Napoli, a Naples ensemble playing the traditional music of southern Italy.',
      it: 'Cantante e fisarmonicista. Guida gli Ars Nova Napoli, ensemble napoletano che suona la musica tradizionale del Sud Italia.',
    },
  },
  {
    nome: 'Luca Lanzano', foto: null,
    ruolo: { en: 'Filmmaker', it: 'Filmmaker' },
    bio: {
      en: 'Director and cinematographer. Makes documentaries and short films, including <em>Alan – Il racconto di un ignorante</em>.',
      it: 'Regista e direttore della fotografia. Realizza documentari e cortometraggi, tra cui <em>Alan – Il racconto di un ignorante</em>.',
    },
  },
  {
    nome: 'Bruno Belardi', foto: null,
    ruolo: { en: 'Sound Engineer', it: 'Fonico' },
    bio: {
      en: 'Electroacoustic composer and double bassist. Composes acousmatic music from field recordings and acoustic sounds, and plays in Ars Nova Napoli.',
      it: 'Compositore elettroacustico e contrabbassista. Compone musica acusmatica a partire da field recording e suoni acustici, e suona negli Ars Nova Napoli.',
    },
  },
];

const testi = {
  en: {
    titolo: 'About',
    apertura: 'Folk musicians passing through Naples, recorded outdoors.',
    testo: 'Napoli Folks records folk musicians outdoors, in Naples. We catch the artists who happen to pass through the city.',
    foto: 'photo',
    bio: 'bio of',
    trovaci: 'Find us',
    dove: 'All our videos and materials are on Instagram and YouTube.',
  },
  it: {
    titolo: 'Chi siamo',
    apertura: 'Musicisti folk di passaggio a Napoli, registrati all’aperto.',
    testo: 'Napoli Folks registra musicisti folk all’aperto, a Napoli. Intercettiamo gli artisti che si trovano a passare per la città.',
    foto: 'foto',
    bio: 'bio di',
    trovaci: 'Dove trovarci',
    dove: 'Tutti i nostri video e materiali sono su Instagram e YouTube.',
  },
}[l];

const link = [
  { icona: 'instagram' as const, testo: 'Instagram', dettaglio: '@napoli_folks_live', url: SITO.instagram },
  { icona: 'youtube' as const, testo: 'YouTube', dettaglio: '@napolifolkslive', url: SITO.youtube },
  { icona: 'email' as const, testo: 'Email', dettaglio: SITO.email, url: `mailto:${SITO.email}` },
];
---
<Base titolo={testi.titolo}>
  <section class="sezione contenitore">
    <h1>{testi.titolo}</h1>
    <div class="testo">
      <!-- Testo scritto a partire dalle parole di Bruno: da approvare. -->
      <p class="apertura">{testi.apertura}</p>
      <p>{testi.testo}</p>
    </div>

    <ul class="squadra">
      {squadra.map((p) => (
        <li class="persona">
          {p.foto
            ? <img class="foto" src={p.foto} alt={p.nome} width="800" height="1000" loading="lazy" />
            : <div class="foto vuota"><Segnaposto>{testi.foto}</Segnaposto></div>}
          <div class="scheda">
            <h2>{p.nome}</h2>
            <p class="ruolo dettaglio">{p.ruolo[l]}</p>
            {p.bio
              ? <p class="bio" set:html={p.bio[l]} />
              : <Segnaposto blocco>{testi.bio} {p.nome}</Segnaposto>}
          </div>
        </li>
      ))}
    </ul>

    <div class="testo">
      <h2 class="titolo-contatti">{testi.trovaci}</h2>
      <p>{testi.dove}</p>
      <ul class="contatti">
        {link.map((l) => (
          <li>
            <a href={l.url} rel="noopener">
              <Icona nome={l.icona} />
              <span><strong>{l.testo}</strong> <span class="dettaglio-link">{l.dettaglio}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .apertura { font-family: var(--serif); font-size: clamp(1.35rem, 3.2vw, 1.9rem); line-height: 1.25; margin-bottom: 0.6em; }
  /* Squadra: una persona per riga, foto piccola a sinistra e testo a destra (anche su telefono). */
  .squadra {
    list-style: none; margin: clamp(40px, 7vw, 80px) 0; padding: 0;
    display: grid; gap: clamp(32px, 5vw, 48px); max-width: 44em;
  }
  .persona {
    display: grid; align-items: start;
    grid-template-columns: clamp(96px, 24vw, 160px) 1fr;
    gap: clamp(16px, 3vw, 32px);
  }
  .foto { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .foto.vuota {
    display: flex; align-items: center; justify-content: center; text-align: center; padding: 8px;
    background: var(--fondo-2); border: 1px solid var(--linea);
  }
  .persona h2 { font-size: clamp(1.3rem, 3vw, 1.8rem); line-height: 1.15; margin: 0 0 4px; }
  .ruolo { margin: 0 0 10px; color: var(--accento); }
  .bio { margin: 0; color: var(--testo-2); }
  .titolo-contatti { margin-top: 0; }
  .contatti { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .contatti a { display: inline-flex; align-items: center; gap: 14px; padding: 8px 0; text-decoration: none; }
  .contatti strong { font-weight: 500; }
  .dettaglio-link { color: var(--testo-2); margin-left: 6px; }
  .contatti a:hover, .contatti a:hover .dettaglio-link { color: var(--accento); }
</style>
